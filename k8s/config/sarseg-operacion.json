    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Deployment de Grafana durante las pruebas",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sarseg"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_spec_replicas{namespace=\"sarseg-observabilidad\",deployment=\"grafana\"}",
          "legendFormat": "Deseadas"
        },
        {
          "refId": "B",
          "expr": "kube_deployment_status_replicas_available{namespace=\"sarseg-observabilidad\",deployment=\"grafana\"}",
          "legendFormat": "Disponibles"
        },
        {
          "refId": "C",
          "expr": "kube_deployment_status_replicas_updated{namespace=\"sarseg-observabilidad\",deployment=\"grafana\"}",
          "legendFormat": "Actualizadas"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "axisLabel": "Réplicas"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Fuentes de Prometheus · 1 significa UP",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sarseg"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    }
