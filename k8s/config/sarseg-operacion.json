{
  "uid": "sarseg-operacion",
  "title": "SARSEG | Operación de Kubernetes",
  "tags": [
    "SARSEG",
    "P2",
    "Kubernetes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Alcance de las métricas",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Laboratorio SARSEG P2** · Deployment → ReplicaSet → Pods · Métricas reales de `sarseg-observabilidad`. La API de asistencia no está desplegada en esta práctica."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Grafana · réplicas deseadas",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sarseg"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 2
      },
      "targets": [
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"sarseg-observabilidad\",deployment=\"grafana\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Grafana · réplicas disponibles",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sarseg"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 2
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"sarseg-observabilidad\",deployment=\"grafana\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pods de infraestructura Running",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sarseg"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 2
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{namespace=\"sarseg-observabilidad\",phase=\"Running\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
